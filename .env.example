DEEPSEEK_API_KEY=

# Optional: EU-hosted model, used for "eu" mode and as the LLM judge.
MISTRAL_API_KEY=

# Optional overrides (defaults shown)
# LEDGERLENS_DATA_DIR=data
# LEDGERLENS_LOG_LEVEL=INFO
